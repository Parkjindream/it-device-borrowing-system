# .env ไฟล์เดียวที่รากโปรเจกต์ ใช้ทั้ง docker compose และ runserver — cp .env.example .env (ห้ามขึ้น git: มีรหัสผ่าน)
# runserver บนเครื่อง: ตั้ง DEBUG=True และ SECURE_COOKIES=False / DB กับ MinIO ต่อ infra ที่ localhost ให้เอง

# --- Django ---
# สุ่มใหม่: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=เปลี่ยนเป็นค่าสุ่มยาวๆที่ไม่ซ้ำใคร
DEBUG=False
# มีโดเมนจริงแล้วเพิ่มต่อท้าย เช่น ,borrow.yourcollege.ac.th และ ,https://borrow.yourcollege.ac.th
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
# True เมื่อเข้าเว็บผ่าน https เท่านั้น
SECURE_COOKIES=False
# อยู่หลัง reverse proxy (https): USE_X_FORWARDED_PROTO=True และ NUM_PROXIES=จำนวน proxy
# USE_X_FORWARDED_PROTO=True
# NUM_PROXIES=1
# ลิงก์ในอีเมล — เว้นไว้ = ใช้ URL ที่ผู้ใช้เปิดอยู่
# FRONTEND_URL=https://borrow.yourcollege.ac.th

# บัญชีเจ้าหน้าที่ที่สร้างตอน up ครั้งแรก (มีอยู่แล้วจะไม่แตะ / เว้นว่าง = ไม่สร้าง)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourcollege.ac.th
DJANGO_SUPERUSER_PASSWORD=ตั้งรหัสผ่านแอดมินที่คาดเดายากตรงนี้

# บัญชีผู้ใช้ทั่วไปเพิ่มอีก 1 บัญชี (ไม่บังคับ) SEED_USER_ROLE: student | staff
# SEED_USER_USERNAME=
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
# SEED_USER_ROLE=student

# --- PostgreSQL (container "db" สร้างฐานข้อมูลจากค่าเหล่านี้) ---
DB_NAME=it_lending_db
DB_USER=it_lending_user
DB_PASSWORD=ตั้งรหัสผ่านฐานข้อมูลที่คาดเดายากตรงนี้
# ใช้ PostgreSQL บนเครื่องแทน container (ต้องสร้าง DB_NAME ไว้ก่อน)
# DB_HOST=host.docker.internal
# DB_PORT=5432

# --- MinIO (รหัสผ่านอย่างน้อย 8 ตัว) ---
MINIO_ROOT_USER=it-lending-admin
MINIO_ROOT_PASSWORD=ตั้งรหัสผ่าน_MinIO_ที่คาดเดายากตรงนี้

# --- พอร์ตบนเครื่องเซิร์ฟเวอร์ (ผูก 127.0.0.1 เท่านั้น) — ค่าที่เห็นคือค่าเริ่มต้น ---
# HTTP_PORT=80
# DB_EXPOSE_PORT=5433
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- อีเมลจริง (ต้องตั้งก่อนใช้งานจริง) — Gmail ใช้ App password ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=รหัสผ่านแอปที่ได้จาก_https://myaccount.google.com/apppasswords
DEFAULT_FROM_EMAIL=ศูนย์ยืม-คืนอุปกรณ์ไอที <yourname@gmail.com>

# --- ใช้เมื่อเปิด service ที่ปิดไว้ใน docker-compose.yml / docker-compose.infra.yml ---
# BACKUP_HOUR=2                     # db-backup: สำรองกี่โมง (เวลาไทย)
# BACKUP_KEEP_DAYS=14               # db-backup: เก็บย้อนหลังกี่วัน
# PGADMIN_EMAIL=admin@example.com   # pgadmin
# PGADMIN_PASSWORD=

# --- Vercel Cron: ค่าสุ่ม ≥16 ตัว ตั้งใน Vercel ด้วย (เว้นว่าง = ปิด /api/cron/run-jobs/) ---
# CRON_SECRET=
