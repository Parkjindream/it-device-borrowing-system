# ============ ไฟล์ตั้งค่าสำหรับ deploy จริงด้วย Docker ============
# คัดลอกเป็น .env (ชื่อไฟล์ตรง ๆ ไม่มีนามสกุล) แล้ววางไว้ที่ root ของโปรเจกต์
# (โฟลเดอร์เดียวกับ docker-compose.yml) ก่อนรัน docker compose up
#
# *** ห้ามนำไฟล์ .env ขึ้น GitHub หรือที่สาธารณะเด็ดขาด มีรหัสผ่าน/คีย์ลับอยู่ในนี้ ***

# --- Django ---
# สุ่มค่าใหม่เสมอตอน deploy จริง เช่นรันคำสั่งนี้ในเครื่องที่มี python:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=เปลี่ยนเป็นค่าสุ่มยาวๆที่ไม่ซ้ำใคร
DEBUG=False
ALLOWED_HOSTS=borrow.yourcollege.ac.th,www.borrow.yourcollege.ac.th
CSRF_TRUSTED_ORIGINS=https://borrow.yourcollege.ac.th

# --- ฐานข้อมูล (container "db" ใน docker-compose.yml ใช้ค่าพวกนี้สร้างฐานข้อมูลให้เอง) ---
DB_NAME=it_lending_db
DB_USER=it_lending_user
DB_PASSWORD=ตั้งรหัสผ่านฐานข้อมูลที่คาดเดายากตรงนี้

# --- URL จริงของเว็บที่ผู้ใช้เข้า (ใช้ฝังลิงก์ในอีเมลตั้งรหัสผ่านใหม่) ---
FRONTEND_URL=https://borrow.yourcollege.ac.th
FRONTEND_RESET_PASSWORD_URL=https://borrow.yourcollege.ac.th/reset-password.html

# --- พอร์ตที่เปิดให้เข้าเว็บจากภายนอก (ปกติใช้ 80; ถ้ามี reverse proxy ชั้นนอกอีกชั้นค่อยเปลี่ยน) ---
HTTP_PORT=80

# ============ อีเมลจริง (จำเป็นต้องตั้งก่อนใช้งานจริง ไม่งั้นแจ้งเตือนจะไม่ถูกส่งออกไปไหนเลย) ============
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=รหัสผ่านแอปที่ได้จาก_https://myaccount.google.com/apppasswords
DEFAULT_FROM_EMAIL=ศูนย์ยืม-คืนอุปกรณ์ไอที <yourname@gmail.com>
