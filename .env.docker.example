# ============ ไฟล์ตั้งค่าสำหรับ deploy จริงด้วย Docker ============
# คัดลอกเป็น .env (ชื่อไฟล์ตรง ๆ ไม่มีนามสกุล) แล้ววางไว้ที่ root ของโปรเจกต์
# (โฟลเดอร์เดียวกับ docker-compose.yml) ก่อนรัน docker compose up
#
# *** ห้ามนำไฟล์ .env ขึ้น GitHub หรือที่สาธารณะเด็ดขาด มีรหัสผ่าน/คีย์ลับอยู่ในนี้ ***

# --- Django ---
# สุ่มค่าใหม่เสมอตอน deploy จริง เช่นรันคำสั่งนี้ในเครื่องที่มี python:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=เปลี่ยนเป็นค่าสุ่มยาวๆที่ไม่ซ้ำใคร
DEBUG=False
# ค่าด้านล่างรองรับ Cloudflare Quick Tunnel ที่ได้ URL สุ่ม xxx.trycloudflare.com ทุกครั้ง
# (จุดนำหน้า = ทุก subdomain) — พอมีโดเมนจริงให้เปลี่ยนเป็นโดเมนนั้น เช่น borrow.yourcollege.ac.th
ALLOWED_HOSTS=.trycloudflare.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com,http://localhost

# บัญชีแอดมิน (เจ้าหน้าที่) สร้างให้อัตโนมัติตอน docker compose up ครั้งแรก
# ถ้ามีบัญชีชื่อนี้อยู่แล้วจะไม่แตะ (เปลี่ยนรหัสผ่านทีหลังผ่านหน้าเว็บได้ตามปกติ) / เว้นว่างไว้ = ไม่สร้าง
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourcollege.ac.th
DJANGO_SUPERUSER_PASSWORD=ตั้งรหัสผ่านแอดมินที่คาดเดายากตรงนี้

# --- ฐานข้อมูล (container "db" ใน docker-compose.yml ใช้ค่าพวกนี้สร้างฐานข้อมูลให้เอง) ---
DB_NAME=it_lending_db
DB_USER=it_lending_user
DB_PASSWORD=ตั้งรหัสผ่านฐานข้อมูลที่คาดเดายากตรงนี้
# พอร์ตสำหรับต่อ PostgreSQL ด้วย psql/DBeaver จากเครื่องเซิร์ฟเวอร์ (localhost เท่านั้น)
DB_EXPOSE_PORT=5433

# --- สำรองฐานข้อมูลอัตโนมัติลงโฟลเดอร์ ./backups (วิธีกู้คืนดูใน db/backup.sh) ---
# สำรองทุกวันตอนกี่โมง (0-23 เวลาไทย) และเก็บย้อนหลังกี่วัน
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# --- pgAdmin (หน้าเว็บจัดการฐานข้อมูล) — ตอนนี้ปิดไว้ใน docker-compose.yml ใช้เมื่อเปิด service pgadmin ---
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=ตั้งรหัสผ่าน_pgAdmin_ตรงนี้
# PGADMIN_PORT=5050

# --- URL จริงของเว็บที่ผู้ใช้เข้า (ใช้ฝังลิงก์ในอีเมลตั้งรหัสผ่านใหม่) ---
# เว้นว่าง = ใช้ URL เดียวกับที่ผู้ใช้กดขอลิงก์ (เหมาะกับ trycloudflare ที่ URL สุ่มเปลี่ยนเรื่อย ๆ)
# พอมีโดเมนจริงแล้วค่อยใส่ เช่น FRONTEND_URL=https://borrow.yourcollege.ac.th
FRONTEND_URL=

# --- Cloudflare Quick Tunnel (ทางเข้าเว็บจากอินเทอร์เน็ต) — ไม่ต้องตั้งค่าอะไร ไม่ต้องมี token ---
# ดู URL ที่ได้:  docker compose logs cloudflared | grep -o 'https://[a-z0-9-]*\.trycloudflare\.com'

# เว็บเข้าผ่าน https ของ Cloudflare เสมอ จึงเปิดคุกกี้แบบ secure ได้
SECURE_COOKIES=True

# --- พอร์ตสำหรับทดสอบในเครื่องเซิร์ฟเวอร์เอง (http://localhost) — ภายนอกเข้าพอร์ตนี้ไม่ได้ ---
HTTP_PORT=80

# ============ อีเมลจริง (จำเป็นต้องตั้งก่อนใช้งานจริง ไม่งั้นแจ้งเตือนจะไม่ถูกส่งออกไปไหนเลย) ============
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=รหัสผ่านแอปที่ได้จาก_https://myaccount.google.com/apppasswords
DEFAULT_FROM_EMAIL=ศูนย์ยืม-คืนอุปกรณ์ไอที <yourname@gmail.com>
