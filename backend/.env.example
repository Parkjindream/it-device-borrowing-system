# ============ ตั้งค่าสำหรับรันบนเครื่องตัวเอง (พัฒนา/ทดสอบ) ============
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงเครื่องคุณ  (ห้ามนำ .env ขึ้น GitHub)

DJANGO_SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- ฐานข้อมูล PostgreSQL ---
# แบบที่ 1: PostgreSQL ที่ลงไว้บนเครื่อง
DB_NAME=it_lending_db
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432
# แบบที่ 2: ใช้ infra จาก docker (ที่โฟลเดอร์รากโปรเจกต์: docker compose -f docker-compose.infra.yml up -d)
#   ใส่ DB_NAME/DB_USER/DB_PASSWORD ให้ตรงกับ .env ที่รากโปรเจกต์ และใช้พอร์ต DB_EXPOSE_PORT (ค่าเริ่มต้น 5433)
# DB_PORT=5433

# --- เก็บไฟล์อัปโหลดลง MinIO (ไม่บังคับ — เว้นไว้ = เก็บลงโฟลเดอร์ backend/media) ---
# ใช้ MinIO จาก docker-compose.infra.yml ได้เลย (เปิดพอร์ต 9000 ไว้ที่ localhost) ใส่ค่าให้ตรงกับ MINIO_ROOT_* ใน .env ที่รากโปรเจกต์
# แล้วรัน python manage.py ensure_media_bucket ครั้งแรกเพื่อสร้าง bucket
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=it-lending-admin
# MINIO_SECRET_KEY=

# --- ที่อยู่หน้าเว็บสำหรับลิงก์ในอีเมล ---
# หน้าเว็บกับ API อยู่ใน runserver ตัวเดียวกันแล้ว (http://127.0.0.1:8000/) เว้นว่าง = ใช้ที่อยู่ที่ผู้ใช้เปิดอยู่
FRONTEND_URL=

# ============ อีเมล ============
# ค่าเริ่มต้น = console: อีเมลจะ "แค่พิมพ์ใน terminal" ไม่ได้ส่งเข้ากล่องอีเมลจริง
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- ส่งอีเมลจริงผ่าน Gmail (ลบ # ออกทุกบรรทัดข้างล่าง แล้วแก้ค่า, ปิดบรรทัด console ด้านบน) ---
# ต้องเปิด "การยืนยันตัวตน 2 ขั้นตอน" ในบัญชี Google ก่อน แล้วสร้าง "รหัสผ่านสำหรับแอป (App password)"
# ที่ https://myaccount.google.com/apppasswords  (ได้รหัส 16 ตัว ใช้แทนรหัสผ่านปกติ)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=yourname@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=yourname@gmail.com
